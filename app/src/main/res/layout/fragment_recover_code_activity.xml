<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4EA"
    android:padding="18dp">

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◀ Voltar"
        android:textColor="#22A06B"
        android:textSize="15sp"
        android:background="@android:color/transparent"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:gravity="center_horizontal"
            android:background="@drawable/border_background">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_logo"
                android:src="@drawable/folhinhalogo"
                android:contentDescription="Logo RAIFY"
                android:scaleType="centerInside"
                android:padding="10dp"/>

            <TextView
                android:id="@+id/txtRaify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="RAIFY"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#2E7D32"/>

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de Apoio à Transição Orgânica"
                android:textColor="#7A7A7A"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/txtInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insira o código de 6 dígitos, enviado no seu email"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:textAlignment="center"/>

            <!-- Código: rótulo -->
            <TextView
                android:id="@+id/txtCodigoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Código"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginTop="10dp"
                android:layout_gravity="start"/>

            <!-- 6 caixas -->
            <LinearLayout
                android:id="@+id/rowCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="6">

                <!-- 1 -->
                <EditText
                    android:id="@+id/et1"
                    style="@style/CodeBox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="."
                    android:textColorHint="@color/white"
                    android:maxLength="1"/>
                <!-- 2 -->
                <EditText
                    android:id="@+id/et2"
                    style="@style/CodeBox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="."
                    android:textColorHint="@color/white"
                    android:maxLength="1"
                    android:layout_marginStart="8dp"/>
                <!-- 3 -->
                <EditText
                    android:id="@+id/et3"
                    style="@style/CodeBox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="."
                    android:textColorHint="@color/white"
                    android:maxLength="1"
                    android:layout_marginStart="8dp"/>
                <!-- 4 -->
                <EditText
                    android:id="@+id/et4"
                    style="@style/CodeBox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="."
                    android:textColorHint="@color/white"
                    android:maxLength="1"
                    android:layout_marginStart="8dp"/>
                <!-- 5 -->
                <EditText
                    android:id="@+id/et5"
                    style="@style/CodeBox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="."
                    android:textColorHint="@color/white"
                    android:maxLength="1"
                    android:layout_marginStart="8dp"/>
                <!-- 6 -->
                <EditText
                    android:id="@+id/et6"
                    style="@style/CodeBox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:maxLength="1"
                    android:hint="."
                    android:textColorHint="@color/white"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Texto reenviar -->
            <TextView
                android:id="@+id/txtNoCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não achou o código? "
                android:textColor="#7A7A7A"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/txtReenviar"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="Reenviar o código"
                android:textColor="#22A06B"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Botão confirmar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="Confirmar código"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="#19A463"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>