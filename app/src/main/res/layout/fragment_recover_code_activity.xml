<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- FUNDO -->
    <LinearLayout
        android:id="@+id/fundoCodigo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:background="@drawable/bg_fundo"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--BOTÃO DE VOLTAR -->
        <LinearLayout
            android:id="@+id/btnVoltar"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_voltar">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/setaesquerda"
                android:contentDescription="@null"
                app:tint="@color/verde_principal"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="6dp"
                android:text="Voltar"
                android:textColor="@color/verde_principal"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ESPAÇO -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
        <!-- CARD -->
        <LinearLayout
            android:id="@+id/cardCodigo"
            android:layout_width="match_parent"
            android:layout_height="600dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- LOGO -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal">



            </FrameLayout>
        </LinearLayout>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>