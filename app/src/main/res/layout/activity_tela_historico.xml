<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Tela_Historico"
    android:background="@color/cor_fundoaplitivo">

    <!-- ===== CABEÇALHO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/verde_principal"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Botão de menu (hambúrguer) -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            app:tint="@color/white" />

        <!-- LOGO RAIFY (Bolinha verde com a folhinha) -->
        <FrameLayout
            android:id="@+id/logoHeader"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <!-- BOLINHA VERDE (atrás) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo" />

            <!-- FOLINHA (na frente) -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Logo Raify"
                android:src="@drawable/folhinhalogo" />
        </FrameLayout>

        <!-- Espaço para empurrar os ícones para a direita -->
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Botão de Notificação (Sino) -->
        <ImageButton
            android:id="@+id/btnnotificacao"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir notificações"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notificacao"
            app:tint="@color/white" />

        <!-- Botão de Perfil -->
        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pefil"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- ===== TÍTULO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
