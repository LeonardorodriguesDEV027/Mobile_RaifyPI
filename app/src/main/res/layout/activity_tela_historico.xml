<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/telahistorico"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Tela_Historico"
    android:background="@color/cor_fundoaplicativo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra verde | logo + RAIFY | Notificações | Perfil -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barraMenu"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/verde_principal"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="Menu"
            app:navigationIcon="@drawable/ic_menu">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_logo2">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_folhinhalogo"
                        android:layout_gravity="center"
                        app:tint="@color/verde_principal"/>
                </FrameLayout>

                <!-- Nome: "RAIFY" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="RAIFY"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_weight="1"/>

                <!-- Notificações + Perfil -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <!-- Notificações -->
                    <ImageButton
                        android:id="@+id/btnnotificacao"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notificações"
                        android:src="@drawable/ic_notificacao"
                        app:tint="@color/white"
                        android:layout_marginTop="4dp"/>

                    <!-- Bolinha em cima do sino -->
                    <View
                        android:id="@+id/notificacao_bolinha"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_logo2"
                        android:backgroundTint="@color/laranja"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </FrameLayout>

                <!-- Perfil -->
                <ImageButton
                    android:id="@+id/btnPerfil"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_perfil"
                    android:layout_marginEnd="6dp"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- ===== TÍTULO ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Histórico de Transações"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:alpha="0.75"
                    android:text="Todas as receitas e despesas registradas"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

