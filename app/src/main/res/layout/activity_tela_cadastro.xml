<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaCadastro">

    <!-- FUNDO -->
    <LinearLayout
        android:id="@+id/fundoCadastro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="22dp"
        android:background="@drawable/bg_fundo"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÃO DE VOLTAR -->
        <LinearLayout
            android:id="@+id/btnVoltar"
            android:layout_width="120dp"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_voltar">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/setaesquerda"
                android:contentDescription="@null"
                app:tint="@color/verde_principal"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="Voltar"
                android:textColor="@color/verde_principal"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ESPAÇO -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- CARD -->
        <LinearLayout
            android:id="@+id/cardCadastro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- LOGO -->
            <FrameLayout
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal">

                <!-- BOLINHA VERDE (atrás) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo"/>

                <!-- FOLINHA (na frente) -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/folhinhalogo"
                    android:contentDescription="Logo Raify"/>
            </FrameLayout>

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="RAIFY"
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <!-- SUBTÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:text="Sistema de Apoio à Transição Orgânica"
                android:textSize="18sp"
                android:textColor="@color/black"/>

            <!-- NOME COMPLETO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="Nome Completo"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/edtNomecompleto"
                android:layout_width="288dp"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="Seu Nome"
                android:inputType="textPersonName"
                android:background="@drawable/bg_input"/>

            <!-- E-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="E-mail"
                android:textSize="20dp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="288dp"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint="seu.email@exemplo.com"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input"/>

            <!-- TELEFONE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="Telefone"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/edtTelefone"
                android:layout_width="288dp"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint=" (99) 99999-9999"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="phone"
                android:background="@drawable/bg_input"/>

            <!-- SENHA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="Senha"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"/>
            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="288dp"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint="••••••••••••"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"/>

            <!-- CONFIRMAR SENHA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="Confirmar Senha"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"/>
            <EditText
                android:layout_width="288dp"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint="Digite a senha novamente"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"/>

            <!-- BOTÃO "CADASTRAR" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="Cadastrar"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button"
                app:backgroundTint="@color/verde_principal"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>