<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#FFFFFF">

    <!-- FUNDO -->
    <LinearLayout
        android:id="@+id/fundoLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:background="@drawable/bg_fundo"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÃO DE VOLTAR
            OBS: TROCAR PELA SETINHA-->
        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="140dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="<  Voltar"
            android:textColor="#11AE6A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/bg_voltar"/>

        <!-- ESPAÇO -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="70dp" />

        <!-- CARD -->
        <LinearLayout
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!--LOGO-->
            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal">

                <!-- BOLINHA VERDE (atrás) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo"
                    />

                <!-- FOLINHA (na frente) -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/folhinhalogo"
                    android:contentDescription="Logo Raify" />
            </FrameLayout>

            <!--TÍTULO-->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="RAIFY"
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <!--SUSTÍTULO-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:text="Sistema de Apoio à Transição Orgânica"
                android:textSize="18sp"
                android:textColor="@color/black"/>

            <!-- E-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="E-mail"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="288dp"
                android:layout_height="54dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint="seu.email@exemplo.com"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input"/>

            <!-- SENHA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginStart="20dp"
                android:text="Senha"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"/>








        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>