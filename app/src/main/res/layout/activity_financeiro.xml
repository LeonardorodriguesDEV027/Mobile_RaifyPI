<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity_financeiro"
    android:background="@color/cor_fundoaplitivo">

    <!-- ===== CABEÇALHO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/verde_principal"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Botão de menu (hambúrguer) -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            app:tint="@color/white" />

        <!-- LOGO RAIFY (Bolinha verde com a folhinha) -->
        <FrameLayout
            android:id="@+id/logoHeader"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <!-- BOLINHA VERDE (atrás) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo" />

            <!-- FOLINHA (na frente) -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Logo Raify"
                android:src="@drawable/folhinhalogo" />
        </FrameLayout>

        <!-- Espaço para empurrar os ícones para a direita -->
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Botão de Notificação (Sino) -->
        <ImageButton
            android:id="@+id/btnnotificacao"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir notificações"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notificacao"
            app:tint="@color/white" />

        <!-- Botão de Perfil -->
        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pefil"
            app:tint="@color/white" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                tools:ignore="MissingConstraints">

        <!-- Título + subtítulo (ocupam o espaço que sobrar) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Financeiro"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="Receitas e Despesas - Mês de Maio "
                android:textColor="@color/black"
                android:textSize="15sp"
                android:alpha="0.75"/>


        </LinearLayout>

        <!-- Botão à direita de "+ Novo Registro" -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNovoRegistro"
            android:layout_width="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button"
            android:paddingHorizontal="20dp"
            android:text="+ Novo Registro"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            tools:layout_editor_absoluteX="233dp"
            tools:layout_editor_absoluteY="186dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerAbas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="-4dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="#EFEDEB"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabVisaoGeral"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Visão Geral"
            android:textColor="#000000"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabTransacoes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Transações"
            android:textColor="#757575"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabAnalises"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Análises"
            android:textColor="#757575"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- ===== A PARTIR DAQUI É NOVO: FILTRAR POR MÊS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtrar por mês:"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnFiltroMes"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_border_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="100dp"
            android:paddingHorizontal="24dp"
            android:text="Maio"
            android:textColor="#7C4DFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Aqui embaixo vão entrar os cards e o gráfico quando você pedir -->

    <!-- ===== CARDS: RECEITAS / DESPESAS / SALDO / CRESCIMENTO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp">

        <!--- LINHA 1 - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- CARD RECEITAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- fundo do ícone (verde claro) -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#B8E8C1">

                        <!-- coloque o icone aqui -->
                        <ImageView
                            android:src="@drawable/ic_dinheiro"
                            android:id="@+id/icReceitas"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Receitas" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Receitas"
                        android:textColor="#616161"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReceitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="R$ 15.628"
                    android:textColor="#2E9E4F"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD DESPESAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- fundo do ícone (vermelho claro) -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#FFB8B8">

                        <!-- coloque o icone aqui -->
                        <ImageView
                            android:src="@drawable/ic_setaprograssao"
                            android:id="@+id/icDespesas"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Despesas" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Despesas"
                        android:textColor="#616161"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDespesas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="R$ 8.340"
                    android:textColor="#E53935"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- - LINHA 2 - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- CARD SALDO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- fundo do ícone (verde claro) -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#B8E8C1">

                        <!-- coloque o icone aqui -->
                        <ImageView
                            android:src="@drawable/ic_dinheiro"
                            android:id="@+id/icSaldo"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Saldo" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Saldo"
                        android:textColor="#616161"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="R$ 15.628"
                    android:textColor="#2E9E4F"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD CRESCIMENTO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- fundo do ícone (roxo claro) -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#E6DDFB">

                        <!-- coloque o icone aqui -->
                        <ImageView
                            android:src="@drawable/ic_setaprograssao"
                            android:id="@+id/icCrescimento"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Crescimento" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Crescimento"
                        android:textColor="#616161"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCrescimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="+12.6%"
                    android:textColor="#7C4DFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- ===== CARD DO GRÁFICO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título + legenda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Receitas e Despesas"
                android:textColor="#000000"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#4CC264" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Receitas"
                android:textColor="#616161"
                android:textSize="12sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:background="#EF4B4B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Despesas"
                android:textColor="#616161"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPeriodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Últimos 6 meses"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Botões de período -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn6Meses"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_border_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="6 meses"
                android:textColor="#7C4DFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn3Meses"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_border_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="3 meses"
                android:textColor="#7C4DFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn1Mes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_border_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="1 mês"
                android:textColor="#7C4DFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- O GRÁFICO -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/graficoBarras"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp" />

        <!-- DIVISOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <!-- MÉDIAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Média Receitas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Média das Receitas"
                    android:textColor="#616161"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMediaReceitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="R$ 14.900"
                    android:textColor="#2E9E4F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Média Despesas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Média das Despesas"
                    android:textColor="#616161"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMediaDespesas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="R$ 14.900"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Média Lucros -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Média dos Lucros"
                    android:textColor="#616161"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMediaLucros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="R$ 14.900"
                    android:textColor="#7C4DFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>