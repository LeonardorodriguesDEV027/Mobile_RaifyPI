<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9"
    android:padding="24dp">

    <!-- Voltar -->
    <TextView
        android:id="@+id/tvVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&lt; Voltar para o envio do código"
        android:textColor="#2E7D32"
        android:textSize="14sp"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRedefinir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Ícone circular -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_logo"
                android:padding="12dp"
                android:src="@drawable/folhinhalogo"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAIFY"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de Apoio à Transição Orgânica"
                android:textSize="12sp"
                android:textColor="#757575" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Defina uma nova\nsenha para sua conta."
                android:gravity="center"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <!-- Nova Senha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nova Senha"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etNovaSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:inputType="textPassword"
                android:hint="Nova Senha"
                android:paddingStart="12dp"
                android:layout_marginTop="4dp" />

            <!-- Confirma Senha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirma Senha"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etConfirmaSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:inputType="textPassword"
                android:hint="Confirma Senha"
                android:paddingStart="12dp"
                android:layout_marginTop="4dp" />

            <!-- Botão -->
            <Button
                android:id="@+id/btnRedefinir"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Redefinir senha"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>