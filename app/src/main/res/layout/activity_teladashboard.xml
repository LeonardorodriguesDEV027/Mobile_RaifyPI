<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_teladashboard"
    android:background="@color/cor_fundoaplicativo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra verde | logo + RAIFY | Notificações | Perfil -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barraMenu"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/verde_principal"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="Menu"
            app:navigationIcon="@drawable/ic_menu">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_logo2">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_folhinhalogo"
                        android:layout_gravity="center"
                        app:tint="@color/verde_principal"/>
                </FrameLayout>

                <!-- Nome: "RAIFY" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="RAIFY"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_weight="1"/>

                <!-- Notificações + Perfil -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <!-- Notificações -->
                    <ImageButton
                        android:id="@+id/btnnotificacao"
                        android:layout_width="30dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notificações"
                        android:src="@drawable/ic_notificacao"
                        app:tint="@color/white"
                        android:layout_marginTop="4dp"/>

                    <!-- Bolinha em cima do sino -->
                    <View
                        android:id="@+id/notificacao_bolinha"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_logo2"
                        android:backgroundTint="@color/laranja"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </FrameLayout>

                <!-- Perfil -->
                <ImageButton
                    android:id="@+id/btnPerfil"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_perfil2"
                    android:layout_marginEnd="6dp"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Boas-vindas + nome do usuario -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Bem vindo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bem_vindo"
                        android:textColor="@color/cor_texto2"
                        android:textSize="16sp"
                        android:textStyle="normal"/>

                    <!-- nome do usuario -->
                    <TextView
                        android:id="@+id/tvNome_usuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Seu Valdir!"
                        android:textColor="@color/cor_texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Circulo de progresso -->
                <com.google.android.material.card.MaterialCardView
                    android:background="@drawable/bg_card2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="22dp">

                    <!-- Card do Gráfico Circunferencia -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="22dp">

                        <!-- Frame Layout do Gráfico de Circuncferencia -->
                        <FrameLayout
                            android:layout_width="125dp"
                            android:layout_height="120dp">

                            <!-- Gráfico Circunferencia -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progresso_trasicao"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Gráfico de trasição"
                                android:progress="35"
                                app:indicatorColor="@color/verde_principal"
                                app:indicatorDirectionCircular="clockwise"
                                app:indicatorSize="120dp"
                                app:trackColor="#E6EFE9"
                                app:trackCornerRadius="6dp"
                                app:trackThickness="12dp"/>

                            <!-- Porcentagem dentro do gráfico de circunferencia -->
                            <TextView
                                android:id="@+id/tvPorcentagem_progresso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="35%"
                                android:textColor="@color/cor_texto_principal"
                                android:textSize="26sp"
                                android:textStyle="bold"/>
                        </FrameLayout>

                        <!-- Texto + Meses -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- texto: "Transição para orgânico" -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trasicao_para_organico"
                                android:textColor="@color/cor_texto2"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tvTempo_estimado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"
                                android:text="18 meses"
                                android:textColor="@color/cor_texto_principal"
                                android:textSize="22sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ate_certificacao"
                                android:textColor="@color/cor_texto2"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Alertas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card2"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Texto: Alertas e notificações -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="@string/alertas_e_notificações"
                            android:textStyle="bold"
                            android:textColor="@color/cor_texto_principal"
                            android:textSize="16sp"/>

                        <!-- Alerta 1: Pesticida dectado -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Raify.AlertText"
                            app:cardBackgroundColor="#26FF746C">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/pesticida_detectado"
                                style="@style/Raify.AlertText"/>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Alerta 2: Trasição do solo atingiu 6meses -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Raify.AlertText"
                            app:cardBackgroundColor="#E4F8EC">
                            <TextView
                                style="@style/Raify.AlertText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/transição_solo_6meses"/>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Alerta 3:  -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Raify.AlertText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#E4F8EC">
                            <TextView
                                style="@style/Raify.AlertText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/documento_treinamento"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Préximos passos -->
                <TextView
                    style="@style/Raify.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/proximos_passos"/>

                <com.google.android.material.card.MaterialCardView
                    android:background="@drawable/bg_card2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>