<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- FUNDO -->
    <LinearLayout
        android:id="@+id/fundoCodigo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:background="@drawable/bg_fundo"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--BOTÃO DE VOLTAR -->
        <LinearLayout
            android:id="@+id/btnVoltar"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_voltar">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_setaesquerda"
                android:contentDescription="@null"
                app:tint="@color/verde_principal"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="6dp"
                android:text="Voltar"
                android:textColor="@color/verde_principal"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ESPAÇO -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <!-- CARD -->
        <LinearLayout
            android:id="@+id/cardCodigo"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- LOGO -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal">

                <!-- BOlINHA VERDE (atrás) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo"/>

                <!-- FOLINHA (na frente) -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/folhinhalogo"
                    android:contentDescription="Logo Raify"/>
            </FrameLayout>

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="RAIFY"
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <!-- SUBTÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:text="Sistema de Apoio à Transsição Orgânica"
                android:textSize="18sp"
                android:textColor="@color/black"/>

            <!-- NOVA SENHA -->
            <TextView
                android:id="@+id/texNSR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="20dp"
                android:text="Nova Senha"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:labelFor="@+id/edtNSR"/>

            <!-- NSR = Nova Senha Redefinir -->
            <EditText
                android:id="@+id/edtNSR"
                android:layout_width="288dp"
                android:layout_height="54dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint="••••••••"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"/>

            <!-- CONFIRMAR SENHA -->
            <TextView
                android:id="@+id/txtCSR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="20dp"
                android:text="Confirmar Senha"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:labelFor="@+id/edtCSR"/>

            <!-- CSR = Confirmar Senha Redefinir -->
            <EditText
                android:id="@+id/edtCSR"
                android:layout_width="288dp"
                android:layout_height="54dp"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="20dp"
                android:hint="••••••••"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"/>




            <!-- BOTÃO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRedefinir"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="Redefinir senha"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button"
                app:backgroundTint="@color/verde_principal"/>
        </LinearLayout>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>