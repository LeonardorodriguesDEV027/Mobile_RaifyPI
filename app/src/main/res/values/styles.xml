<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CodeBox">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_blocosenha</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:imeOptions">flagNoExtractUi</item>
    </style>

    <!-- Estilo dos 6 campos de digito dos codigos -->
    <style name="CampoCodigo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_campocodigo</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Raify" />

    <style name="Raify.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cinza_borda2</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Titulo dos Cards -->
    <style name="Raify.CardTitle">
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto para os alertas -->
    <style name="Raify.TextoAlerta">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Titulo de Secção -->
    <style name="Raify.SectionTitle">
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- Numero do Card "Proximos Passsos"  -->
    <style name="Raify.NumeroCard_1">
        <item name="android:background">@drawable/bg_circuloverde</item>
        <item name="android:backgroundTint">@color/verde_claro4</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto Titulo para dentro do Card -->
    <style name="Raify.TituloDentroCard">
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Texto Subtitulo para dentro do Card -->
    <style name="Raify.SubTituloDentroCard">
        <item name="android:textColor">@color/cor_texto2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Botão "Ver" Tela dashboard -->
    <style name="Raify.BotaoDashboard" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/verde_escuro3</item>
        <item name="cornerRadius">10dp</item>
    </style>


    <!-- Card dentro de "Acesso Rápido" -->
    <style name="Raify.ShortCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Card icone dentro da tabele -->
    <style name="Raify.ShortcutIcon">
        <item name="background">@drawable/bg_card2</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
    </style>


    <!-- Nome do Card "Secção Acesso Rápido" -->
    <style name="Raify.ShortcutLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Raify.ShortcutImage">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/verde_principal</item>
    </style>

    <!-- Bolinha Documento -->
    <style name="Raify.DocBadge">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:background">@drawable/bg_circulobranco2</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bolinha Documento nome -->
    <style name="Raify.DocName">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Raify.DocStatus">
        <item name="android:textColor">@color/cor_texto2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Raify.PopupRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>


    <style name="Raify.PopupRowIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/cor_texto_principal</item>
    </style>


    <style name="Raify.PopupRowText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textColor">@color/cor_texto_principal</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>